# Local configuration: copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
# Server only: prefer the new secret key; legacy service_role is an alternative.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management API access for schema / RLS migrations (not an API key).
SUPABASE_ACCESS_TOKEN=
# Generate a random secret with at least 32 characters.
JWT_SECRET=
SEED_DEMO_DATA=false
