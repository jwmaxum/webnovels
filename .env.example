# Local configuration: copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
# Server only: prefer the new secret key; legacy service_role is an alternative.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management API access for schema / RLS migrations (not an API key).
SUPABASE_ACCESS_TOKEN=
# Generate a random secret with at least 32 characters.
JWT_SECRET=
SEED_DEMO_DATA=false
# Cloudflare Pages: enable only after DB, Auth and frontend cutover checks.
P0_API_ENABLED=false
AUTH_ONBOARDING_ENABLED=false
AUTHOR_WORKS_ENABLED=false
AUTHOR_DRAFTS_ENABLED=false
AUTHOR_FILES_ENABLED=false
AUTHOR_PUBLISH_ENABLED=false
# Cover upload additionally requires a Cloudflare IMAGES binding; no client-only fallback.
# Planned provider integrations. Server-side transports are implemented; workflow cutover is pending.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MODE=TEST
PORTONE_STORE_ID=
PORTONE_IDENTITY_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_IDENTITY_MODE=TEST
