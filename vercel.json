{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/company/**",
          "public/policies/**",
          "public/css/policies.css"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/admin",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
